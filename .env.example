# =============================================================================
# Stockroom: Neon (hosted database and auth)
# =============================================================================
# Copy this file to .env and fill in the three Neon values.
#
# VITE_* values are served to every browser, so they are public. Never put a
# secret in a VITE_* variable.

# Origin the web app is served from (CORS).
WEB_URL=http://localhost:5173
PORT=3001

# From your project at neon.com.
# Connection string: Dashboard > Connect.
DATABASE_URL=
# Auth URL: Dashboard > Auth > Configuration. Both values are the same URL.
NEON_AUTH_URL=
VITE_NEON_AUTH_URL=

# Leave empty to call /api on the same origin (the Vite proxy in dev). Set
# only when the API is served from a different origin.
# VITE_API_URL=
